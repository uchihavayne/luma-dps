{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma DPS Preview",
  "version": "0.25.0",
  "identifier": "com.luma.independent",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Luma",
      "width": 420,
      "height": 340,
      "minWidth": 320,
      "minHeight": 200,
      "maxWidth": 1600,
      "maxHeight": 1600,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "resizable": true,
      "shadow": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Independent local encounter meter",
    "windows": { "webviewInstallMode": { "type": "skip" } }
  }
}
